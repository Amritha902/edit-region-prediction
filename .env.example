# Copy to .env and fill in.  .env is gitignored.

# --- Instruction generation (generate_prompts.ipynb) ---
# Local LM Studio / llama.cpp server ignores the key entirely — any string works.
# Only set a real key if you point BASE_URL at a hosted provider.
OPENAI_API_KEY=api_key
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
VLM_MODEL=qwen3-vl-1b-merged

# --- Edit generation (generate_edits.ipynb) ---
COMFYUI_SERVER=127.0.0.1:8188

# --- Hugging Face (PixelProse is a gated dataset) ---
# Accept the terms once at huggingface.co/datasets/tomg-group-umd/pixelprose,
# then either `huggingface-cli login` or set this.
HF_TOKEN=

# --- TensorFlow ---
# vit-keras targets tf.keras v1. Required on TensorFlow >= 2.16 where Keras 3 is default.
TF_USE_LEGACY_KERAS=1
